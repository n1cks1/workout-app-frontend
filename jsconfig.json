{
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@components/*": ["src/components/*"],
			"@styles/*": ["src/assets/styles/*"],
			"@hooks/*": ["src/hooks/*"],
			"@routes/*": ["src/routes/*"],
			"@services/*": ["src/services/*"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist"]
}
